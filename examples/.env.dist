# Copy this file to examples/.env and fill in values for local runs.

# Shared credentials and mode
NEXI_SECRET_KEY=
NEXI_LIVE_MODE=false

# Common IDs and references
NEXI_PAYMENT_ID=
NEXI_CHARGE_ID=
NEXI_REFUND_ID=
NEXI_BULK_ID=
NEXI_UNSCHEDULED_SUBSCRIPTION_ID=
NEXI_ORDER_REFERENCE=
NEXI_MY_REFERENCE=
NEXI_EXTERNAL_REFERENCE=

# URLs and request options
NEXI_CHECKOUT_URL=
NEXI_RETURN_URL=
NEXI_CANCEL_URL=
NEXI_TERMS_URL=
NEXI_WEBHOOK_URL=
NEXI_WEBHOOK_AUTHORIZATION=
NEXI_CURRENCY=
NEXI_ENABLED=
NEXI_MERCHANT_NUMBER=

# Amounts and pagination
NEXI_CANCEL_AMOUNT=
NEXI_CHARGE_AMOUNT=
NEXI_REFUND_AMOUNT=
NEXI_SKIP=
NEXI_TAKE=
NEXI_PAGE_NUMBER=
NEXI_PAGE_SIZE=

# Optional operation keys and IDs
NEXI_IDEMPOTENCY_KEY=
NEXI_EXTERNAL_BULK_CHARGE_ID=
NEXI_EXTERNAL_BULK_VERIFICATION_ID=

# Comma-separated IDs
NEXI_PAYMENT_IDS=